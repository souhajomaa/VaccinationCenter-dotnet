@model IEnumerable<VaccinationCenter.Models.RendezVous>
@{
    ViewData["Title"] = "Rendez-vous";
    ViewData["Active"] = "RDV";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="fas fa-calendar-check me-2 text-warning"></i>Rendez-vous</h5>
    <span class="badge bg-secondary fs-6">@Model.Count() total</span>
</div>
<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr><th>ID</th><th>Citoyen</th><th>Vaccin</th><th>Date vaccination</th><th>Doses</th><th>Infirmière</th><th>Actions</th></tr>
      </thead>
      <tbody>
        @foreach (var r in Model)
        {
          <tr>
            <td><span class="badge bg-secondary">#@r.RendezVousId</span></td>
            <td>@(r.Citoyen != null ? $"{r.Citoyen.Nom} {r.Citoyen.Prenom}" : "-")</td>
            <td>
                @if (r.Vaccin != null)
                {
                    <span class="badge bg-primary">@r.Vaccin.TypeVaccin</span>
                }
            </td>
            <td>@r.DateVaccination.ToString("dd/MM/yyyy HH:mm")</td>
            <td><span class="badge bg-info text-dark">@r.NbrDoses dose(s)</span></td>
            <td><code>@r.CodeInfirmiere</code></td>
            <td>
              <form method="post" action="/Admin/DeleteRendezVous" class="d-inline"
                    onsubmit="return confirm('Supprimer ce rendez-vous ?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@r.RendezVousId" />
                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-calendar fa-3x mb-3 opacity-25"></i><p>Aucun rendez-vous</p>
        </div>
    }
  </div>
</div>
