@model IEnumerable<VaccinationCenter.Models.CentreVaccination>
@{
    ViewData["Title"] = "Centres de vaccination";
    ViewData["Active"] = "Centres";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="fas fa-hospital me-2 text-purple"></i>Centres de vaccination</h5>
    <a href="/Admin/CreateCentre" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Ajouter un centre</a>
</div>
<div class="row g-3">
@foreach (var c in Model)
{
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="badge bg-primary">#@c.CentreVaccinationId</span>
                    <div>
                        <a href="/Admin/EditCentre/@c.CentreVaccinationId" class="btn btn-sm btn-outline-primary py-0"><i class="fas fa-edit"></i></a>
                        <form method="post" action="/Admin/DeleteCentre" class="d-inline" onsubmit="return confirm('Supprimer ?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.CentreVaccinationId" />
                            <button class="btn btn-sm btn-outline-danger py-0"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </div>
                <h6 class="fw-bold">@c.ResponsableCentre</h6>
                <div class="small text-muted d-flex flex-column gap-1 mt-2">
                    <span><i class="fas fa-users me-1 text-primary"></i>Capacité : <strong>@c.Capacite</strong></span>
                    <span><i class="fas fa-chair me-1 text-success"></i>Chaises : <strong>@c.NbChaises</strong></span>
                    <span><i class="fas fa-phone me-1 text-warning"></i>Tél : <strong>@c.NumTelephone</strong></span>
                </div>
            </div>
        </div>
    </div>
}
</div>
@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-hospital fa-3x mb-3 opacity-25"></i><p>Aucun centre enregistré</p>
    </div>
}
