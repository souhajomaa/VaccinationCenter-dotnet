@model IEnumerable<VaccinationCenter.Models.Compte>
@{
    ViewData["Title"] = "Comptes utilisateurs";
    ViewData["Active"] = "Comptes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="fas fa-user-shield me-2 text-danger"></i>Comptes utilisateurs</h5>
    <span class="badge bg-secondary fs-6">@Model.Count() comptes</span>
</div>
<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr><th>ID</th><th>Login</th><th>Rôle</th></tr>
      </thead>
      <tbody>
        @foreach (var c in Model)
        {
          <tr>
            <td><span class="badge bg-secondary">#@c.Id</span></td>
            <td><i class="fas fa-user me-1 text-muted"></i>@c.Login</td>
            <td>
              @if (c.Role == VaccinationCenter.Models.Role.Admin)
              {
                  <span class="badge bg-danger"><i class="fas fa-crown me-1"></i>Admin</span>
              }
              else
              {
                  <span class="badge bg-secondary">User</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
