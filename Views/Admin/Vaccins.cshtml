@model IEnumerable<VaccinationCenter.Models.Vaccin>
@{
    ViewData["Title"] = "Gestion des vaccins";
    ViewData["Active"] = "Vaccins";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="fas fa-vial me-2 text-primary"></i>Vaccins</h5>
    <a href="/Admin/CreateVaccin" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i>Ajouter un vaccin
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th><th>Type</th><th>Fournisseur</th><th>Quantité</th><th>Date validité</th><th>Centre</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td><span class="badge bg-secondary">#@v.VaccinId</span></td>
                        <td>
                            @{
                                var color = v.TypeVaccin.ToString() == "PFizer" ? "primary" :
                                            v.TypeVaccin.ToString() == "Moderna" ? "success" : "warning";
                            }
                            <span class="badge bg-@color">@v.TypeVaccin</span>
                        </td>
                        <td>@v.Fournisseur</td>
                        <td>
                            <span class="@(v.Quantite > 0 ? "text-success" : "text-danger") fw-bold">@v.Quantite</span>
                        </td>
                        <td>
                            <span class="@(v.DateValidite >= DateTime.Now ? "text-success" : "text-danger")">
                                @v.DateValidite.ToString("dd/MM/yyyy")
                            </span>
                        </td>
                        <td>@(v.CentreVaccination?.ResponsableCentre ?? "-")</td>
                        <td>
                            <a href="/Admin/EditVaccin/@v.VaccinId" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="/Admin/DeleteVaccin" class="d-inline"
                                  onsubmit="return confirm('Supprimer ce vaccin ?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@v.VaccinId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-vial fa-3x mb-3 opacity-25"></i>
                <p>Aucun vaccin enregistré</p>
            </div>
        }
    </div>
</div>
