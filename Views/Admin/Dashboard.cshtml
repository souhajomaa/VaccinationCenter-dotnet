@model VaccinationCenter.Services.StatistiquesDto
@{
    ViewData["Title"] = "Tableau de bord";
    ViewData["Active"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white" style="background:linear-gradient(135deg,#0d6efd,#0a4ab5)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75 mb-1">Total Citoyens</div>
                    <div class="fs-2 fw-bold">@Model.TotalCitoyens</div>
                </div>
                <i class="fas fa-users fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white" style="background:linear-gradient(135deg,#198754,#0d6b3f)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75 mb-1">Total Vaccins</div>
                    <div class="fs-2 fw-bold">@Model.TotalVaccins</div>
                </div>
                <i class="fas fa-vial fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white" style="background:linear-gradient(135deg,#fd7e14,#c96a0f)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75 mb-1">Rendez-vous</div>
                    <div class="fs-2 fw-bold">@Model.TotalRendezVous</div>
                </div>
                <i class="fas fa-calendar-check fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white" style="background:linear-gradient(135deg,#6f42c1,#55329a)">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75 mb-1">Centres</div>
                    <div class="fs-2 fw-bold">@Model.TotalCentres</div>
                </div>
                <i class="fas fa-hospital fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fas fa-chart-pie me-2 text-primary"></i>Répartition par type de vaccin</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <canvas id="typeChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fas fa-chart-bar me-2 text-success"></i>Rendez-vous par mois (@DateTime.Now.Year)</h6>
            </div>
            <div class="card-body">
                <canvas id="rdvChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fas fa-check-circle text-success me-2"></i>Vaccins disponibles</h6>
                <div class="display-5 fw-bold text-success">@Model.VaccinsDisponibles</div>
                <small class="text-muted">types avec stock positif et non expirés</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fas fa-times-circle text-danger me-2"></i>Vaccins expirés</h6>
                <div class="display-5 fw-bold text-danger">@Model.VaccinsExpires</div>
                <small class="text-muted">types dont la date de validité est dépassée</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body d-flex flex-column gap-2">
                <h6 class="fw-bold"><i class="fas fa-bolt text-warning me-2"></i>Actions rapides</h6>
                <a href="/Admin/Vaccins" class="btn btn-sm btn-outline-primary"><i class="fas fa-vial me-1"></i>Gérer vaccins</a>
                <a href="/Admin/Citoyens" class="btn btn-sm btn-outline-success"><i class="fas fa-users me-1"></i>Gérer citoyens</a>
                <a href="/Admin/RendezVous" class="btn btn-sm btn-outline-warning"><i class="fas fa-calendar me-1"></i>Voir rendez-vous</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    // Pie chart - vaccins by type
    const typeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VaccinsByType));
    new Chart(document.getElementById('typeChart'), {
        type: 'doughnut',
        data: {
            labels: Object.keys(typeData),
            datasets: [{ data: Object.values(typeData), backgroundColor: ['#0d6efd','#198754','#fd7e14'], borderWidth: 0 }]
        },
        options: { plugins: { legend: { position: 'bottom' } }, cutout: '65%' }
    });

    // Bar chart - RDV by month
    const rdvData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RendezVousByMonth));
    new Chart(document.getElementById('rdvChart'), {
        type: 'bar',
        data: {
            labels: Object.keys(rdvData),
            datasets: [{ label: 'Rendez-vous', data: Object.values(rdvData), backgroundColor: 'rgba(13,110,253,.75)', borderRadius: 6 }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
    });
</script>
}
