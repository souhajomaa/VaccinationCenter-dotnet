@model VaccinationCenter.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Connexion";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaccinCenter – Connexion</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }
        .login-wrapper {
            display: flex; width: 900px; min-height: 560px;
            border-radius: 20px; overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,.5);
        }
        .login-left {
            flex: 1; background: linear-gradient(160deg, #0d6efd, #0a4ab5);
            padding: 3rem; display: flex; flex-direction: column;
            justify-content: center; align-items: flex-start;
        }
        .login-left .icon-wrap {
            width: 70px; height: 70px; background: rgba(255,255,255,.15);
            border-radius: 18px; display: flex; align-items: center;
            justify-content: center; margin-bottom: 2rem;
        }
        .login-left h1 { color: #fff; font-size: 2rem; font-weight: 800; margin-bottom: .5rem; }
        .login-left p { color: rgba(255,255,255,.75); font-size: .95rem; line-height: 1.6; }
        .feature { display: flex; align-items: center; gap: 10px; color: rgba(255,255,255,.85);
            margin-top: 1rem; font-size: .88rem; }
        .feature i { width: 30px; height: 30px; background: rgba(255,255,255,.15);
            border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .login-right {
            flex: 1; background: #fff; padding: 3rem;
            display: flex; flex-direction: column; justify-content: center;
        }
        .login-right h2 { font-weight: 700; color: #1a1f2e; margin-bottom: .3rem; }
        .login-right p.sub { color: #6c757d; font-size: .9rem; margin-bottom: 2rem; }
        .form-label { font-size: .83rem; font-weight: 600; color: #374151; }
        .form-control {
            border: 1.5px solid #e5e7eb; border-radius: 10px;
            padding: .65rem 1rem; font-size: .9rem; transition: all .2s;
        }
        .form-control:focus { border-color: #0d6efd; box-shadow: 0 0 0 3px rgba(13,110,253,.12); }
        .btn-login {
            background: linear-gradient(135deg, #0d6efd, #0a4ab5);
            border: none; color: #fff; padding: .75rem; border-radius: 10px;
            font-size: .95rem; font-weight: 600; width: 100%; margin-top: .5rem;
            transition: transform .15s, box-shadow .15s;
        }
        .btn-login:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(13,110,253,.4); }
        .divider { text-align: center; margin: 1.2rem 0; color: #9ca3af; font-size: .85rem; }
        .link-register { color: #0d6efd; text-decoration: none; font-weight: 600; }
        @@media (max-width: 700px) { .login-left { display: none; } .login-wrapper { width: 95%; } }
    </style>
</head>
<body>
<div class="login-wrapper">
    <div class="login-left">
        <div class="icon-wrap"><i class="fas fa-syringe fa-2x text-white"></i></div>
        <h1>VaccinCenter</h1>
        <p>Plateforme de gestion du centre de vaccination nationale.</p>
        <div class="feature"><i class="fas fa-shield-alt"></i> Données sécurisées</div>
        <div class="feature"><i class="fas fa-calendar-check"></i> Réservation en ligne</div>
        <div class="feature"><i class="fas fa-chart-bar"></i> Statistiques temps réel</div>
    </div>
    <div class="login-right">
        <h2>Connexion</h2>
        <p class="sub">Entrez vos identifiants pour accéder à votre espace</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger p-2 small mb-3">
                <i class="fas fa-exclamation-circle me-1"></i>
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success p-2 small mb-3">@TempData["Success"]</div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Login" class="form-label">Login</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                    <input asp-for="Login" class="form-control border-start-0 ps-0" placeholder="Votre login" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mot de passe</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="Votre mot de passe" />
                </div>
            </div>
            <button type="submit" class="btn btn-login">
                <i class="fas fa-sign-in-alt me-2"></i>Se connecter
            </button>
        </form>
        <div class="divider">— Pas encore de compte ? —</div>
        <div class="text-center">
            <a href="/Account/Register" class="link-register">
                <i class="fas fa-user-plus me-1"></i>Créer un compte
            </a>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>
